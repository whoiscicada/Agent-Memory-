# Vector store: "pinecone" or "weaviate"
VECTOR_STORE=weaviate

# Pinecone (if VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=memory-engine

# Weaviate (if VECTOR_STORE=weaviate)
WEAVIATE_URL=http://localhost:8080

# OpenAI
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_engine

# Lifecycle
EPISODIC_TTL_DAYS=30
SEMANTIC_TTL_DAYS=90
SUMMARIZATION_THRESHOLD_DAYS=7
MAX_MEMORIES_PER_AGENT=10000
